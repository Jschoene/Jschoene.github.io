@article{schoene2023negative,
  bibtex_show = {true},
  title       = {Negative Expressions are Shared more on {Twitter} for Public Figures than for Ordinary Users},
  author      = {Sch{\"o}ne, Jonas P. and Garcia, David and Parkinson, Brian and Goldenberg, Amit},
  journal     = {PNAS Nexus},
  volume      = {2},
  number      = {7},
  pages       = {pgad219},
  year        = {2023},
  doi         = {10.1093/pnasnexus/pgad219},
  html        = {https://doi.org/10.1093/pnasnexus/pgad219},
  abbr        = {PNAS Nexus},
  selected    = {true},
  abstract    = {Negativity is shared more for public figures than ordinary users on Twitter (N = 6,678 users; 855,715 posts). Among ordinary users, 22\% of posts were negative and 24\% of shared content was negative. For public figures, 21\% of posts were negative but 31\% of shared content was negative. This differential effect was fully mediated by follower count and political-content frequency.}
}

