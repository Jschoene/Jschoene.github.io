@article{schoene2025overestimation,
  bibtex_show = {true},
  title       = {Overestimation in the aggregation of emotional intensity of social media content},
  author      = {Sch{\"o}ne, Jonas P. and Rocklage, Matthew D. and Parkinson, Brian and Goldenberg, Amit},
  journal     = {Journal of Personality and Social Psychology},
  year        = {2025},
  doi         = {10.1037/pspa0000458},
  html        = {https://doi.org/10.1037/pspa0000458},
  abbr        = {JPSP},
  selected    = {true},
  abstract    = {People systematically overestimate the average emotional intensity of text-based social media responses. Across five studies (N = 1,051), participants consistently overestimated the average emotional intensity, with consequences for how they perceive public opinion and news articles. This overestimation reveals a new cognitive mechanism through which social media contributes to the amplification of emotions.}
}

