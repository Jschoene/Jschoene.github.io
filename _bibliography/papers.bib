@article{schoene2025filtering,
  bibtex_show = {true},
  title       = {Filtering negative affective content from social media increases well-being},
  author      = {Sch{\"o}ne, Jonas P. and Piccardi, Tiziano and Wang, Christy and Bernstein, Michael and Knutson, Brian and Tsai, Jeanne},
  year        = {2025},
  note        = {Under Review},
  abbr        = {Under Review},
  abstract    = {A browser extension that tracked participants' Twitter/X feeds in real time and experimentally reduced exposure to high-arousal negative content. Across two preregistered longitudinal studies (7,455 total observations; N = 309), users reported higher life satisfaction during weeks when negative content was filtered, and filtering also reduced self-reported anxiety and depression.}
}

